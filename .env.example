FEEDMOB_API_BASE=https://staging.example.com
FEEDMOB_KEY=your_key
FEEDMOB_SECRET=your_secret
# Caller identity (must be a @feedmob.com address)
FEEDMOB_USER_EMAIL=you@feedmob.com
# Required for HTTP server: local for isolated development, google for team use.
TALLY_AUTH_MODE=local
# Local mode only (choose a private value of at least 16 characters).
# MCP_HTTP_TOKEN=replace-with-local-development-token
# Team mode only: configure an authorized Google OAuth client and HTTPS callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://your-tally-host.example/auth/google/callback
